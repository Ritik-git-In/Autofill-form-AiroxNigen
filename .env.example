# Copy this file to .env and fill in a key to use real AI extraction.
# Without any key set, the app falls back to a basic regex extractor so you
# can still test the upload -> review -> generate flow offline.

# Kimi (Moonshot AI) -- checked first if set.
KIMI_API_KEY=your-key-here
# Only needed if your Kimi account is on the China platform
# (api.moonshot.cn) instead of the international one (default below).
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# Only needed if the default model id below is wrong/outdated for your
# account -- check your Kimi console for the exact model id.
# KIMI_MODEL=moonshot-v1-128k

# Anthropic (Claude) -- used if KIMI_API_KEY isn't set.
ANTHROPIC_API_KEY=your-key-here
